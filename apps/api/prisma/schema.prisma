generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Connexion "pooled" (Neon -pooler, pgbouncer=true) utilisée par l'app à l'exécution.
  url       = env("DATABASE_URL")
  // Connexion directe (non-pooled) utilisée uniquement par `prisma migrate` / `db push`.
  // En local, mettre la même valeur que DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String?  @unique
  passwordHash    String? // null pour les comptes créés via Google
  googleId        String?  @unique
  name            String
  initials        String
  avatarUrl       String?
  level           Int // 1..5 — voir model Level
  age             Int?
  bio             String?
  city            String?
  clubId          String?
  racquet         String?
  preferredCourts String[]
  preferredTimes  String[]
  joinedAt        DateTime @default(now())
  online          Boolean  @default(false)
  role            String   @default("member") // 'member' | 'admin'
  rating          Int      @default(1000)
  ratingGames     Int      @default(0)
  ratingDelta     Int      @default(0)
  bestRanking     Int?

  club                     Club?                     @relation(fields: [clubId], references: [id])
  matchesAsHost            Match[]                   @relation("host")
  matchesAsGuest           Match[]                   @relation("guest")
  dispos                   DispoPost[]
  notifications            Notification[]
  quickMatchesAsChallenger QuickMatch[]              @relation("quickMatchChallenger")
  quickMatchesAsChallenged QuickMatch[]              @relation("quickMatchChallenged")
  conversations            ConversationParticipant[]
  messagesSent             Message[]

  @@index([rating, ratingGames])
  @@index([level, online])
  @@index([city])
  @@index([clubId])
}

// Clubs / structures de tennis — éditables par un admin (pas de redéploiement).
// Club = **unique entité « lieu »** de l'appli (fusion avec l'ancienne table Court,
// aoû. 2026). Sert à la fois d'appartenance des membres (`User.clubId`), d'annuaire
// (`/clubs`, `/clubs/:slug`) et de lieu de jeu : `court` reste stocké en texte sur
// Match/DispoPost/QuickMatch (historique stable), on rapproche par `name` pour la carte.
model Club {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  zone        String   @default("")
  location    String   @default("") // libellé court (affiché sur les cartes de l'annuaire)
  address     String? // adresse complète (fiche club)
  description String? // présentation du club (fiche club)
  feesInfo    String? // honoraires / cotisation, texte libre (fiche club)
  phone       String? // contact du club
  website     String? // site web du club
  imageUrl    String? // photo du club (Cloudinary, dossier atc/clubs) — null = placeholder
  lat         Float? // position (carte du lieu de jeu + fiche club)
  lng         Float?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  users User[]

  @@index([active, sortOrder])
}

// Les 5 niveaux : contenu affiché (nom, profil, jeu) éditable par un admin.
// Les bornes de rating ELO restent dans le code (src/modules/matches/elo.ts).
model Level {
  level     Int      @id // 1..5
  code      String // 'N1'..'N5'
  nom       String
  profil    String
  jeu       String
  updatedAt DateTime @default(now()) @updatedAt
}

model DispoPost {
  id        String         @id @default(cuid())
  userId    String
  when      DateTime
  duration  Int
  court     String
  type      String // 'simple' | 'double' | 'mixte'
  note      String?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id])
  requests  MatchRequest[]
  match     Match?
  conversation Conversation?

  @@index([userId])
  @@index([when, type])
}

model MatchRequest {
  id          String    @id @default(cuid())
  dispoPostId String
  requesterId String
  status      String // 'pending' | 'accepted' | 'declined'
  dispoPost   DispoPost @relation(fields: [dispoPostId], references: [id])

  @@index([dispoPostId, status])
  @@index([requesterId])
}

model QuickMatch {
  id           String   @id @default(cuid())
  challengerId String
  challengedId String
  when         DateTime
  court        String
  type         String // 'simple' | 'double' | 'mixte'
  note         String?
  status       String   @default("pending") // 'pending' | 'accepted' | 'declined'
  createdAt    DateTime @default(now())
  challenger   User     @relation("quickMatchChallenger", fields: [challengerId], references: [id])
  challenged   User     @relation("quickMatchChallenged", fields: [challengedId], references: [id])
  match        Match?
  conversation Conversation?

  @@index([challengerId, status])
  @@index([challengedId, status])
  @@index([when])
}

model Match {
  id           String      @id @default(cuid())
  hostId       String
  guestId      String
  playedAt     DateTime
  court        String
  type         String
  scoreHost    String
  scoreGuest   String
  winnerId     String
  status       String      @default("confirmed") // 'pending' | 'confirmed' | 'disputed'
  recordedBy   String? // userId who submitted the score
  dispoPostId  String?     @unique
  quickMatchId String?     @unique
  host         User        @relation("host", fields: [hostId], references: [id])
  guest        User        @relation("guest", fields: [guestId], references: [id])
  dispoPost    DispoPost?  @relation(fields: [dispoPostId], references: [id])
  quickMatch   QuickMatch? @relation(fields: [quickMatchId], references: [id])

  @@index([hostId, status, playedAt])
  @@index([guestId, status, playedAt])
  @@index([winnerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // 'match_request' | 'match_confirmed' | 'match_declined' | 'quick_match_request' | 'score_recorded'
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ── Messagerie 1-to-1 entre joueurs (Sprint 8, Lot 1) ───────────────────────
// Une conversation est créée automatiquement à l'acceptation d'une proposition
// de match. Elle est rattachée à l'entité d'appariement (DispoPost OU QuickMatch),
// en miroir du modèle Match — pas au modèle Match, qui n'existe qu'au score.
model Conversation {
  id            String   @id @default(cuid())
  dispoPostId   String?  @unique
  quickMatchId  String?  @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now()) // tri de la liste des conversations

  dispoPost    DispoPost?                @relation(fields: [dispoPostId], references: [id])
  quickMatch   QuickMatch?               @relation(fields: [quickMatchId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now()) // base du calcul des non-lus

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String // borné 1..2000 par Zod
  createdAt      DateTime  @default(now())
  readAt         DateTime? // 1-to-1 : posé quand le destinataire ouvre la conversation

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
