generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Connexion "pooled" (Neon -pooler, pgbouncer=true) utilisée par l'app à l'exécution.
  url       = env("DATABASE_URL")
  // Connexion directe (non-pooled) utilisée uniquement par `prisma migrate` / `db push`.
  // En local, mettre la même valeur que DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  passwordHash    String? // null pour les comptes créés via Google
  googleId        String?   @unique
  name            String
  initials        String
  avatarUrl       String?
  level           Int // 1..5 — voir model Level
  age             Int?
  gender          String? // 'homme' | 'femme', auto-déclaratif — utilisé pour les tournois réservés (ex. féminin)
  bio             String?
  city            String?
  clubId          String?
  racquet         String?
  preferredCourts String[]
  preferredTimes  String[]
  joinedAt        DateTime  @default(now())
  online          Boolean   @default(false)
  emailVerified   Boolean   @default(false) // e-mail confirmé (Google = true d'office)
  termsAcceptedAt DateTime? // date d'acceptation des CGU + politique de confidentialité
  termsVersion    String? // version des textes acceptée (voir src/lib/legal.ts)
  role            String    @default("member") // 'member' | 'admin'
  isGuest         Boolean   @default(false) // inscrit à un tournoi par un admin, sans compte réel — exclu des listes membres/classement
  rating          Int       @default(1000)
  ratingGames     Int       @default(0)
  ratingDelta     Int       @default(0)
  bestRanking     Int?

  club                     Club?                     @relation(fields: [clubId], references: [id])
  matchesAsHost            Match[]                   @relation("host")
  matchesAsGuest           Match[]                   @relation("guest")
  dispos                   DispoPost[]
  notifications            Notification[]
  quickMatchesAsChallenger QuickMatch[]              @relation("quickMatchChallenger")
  quickMatchesAsChallenged QuickMatch[]              @relation("quickMatchChallenged")
  conversations            ConversationParticipant[]
  messagesSent             Message[]
  pushSubscriptions        PushSubscription[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  achievements             Achievement[]
  tournamentRegistrations  TournamentRegistration[]
  tournamentResults        TournamentResult[]
  tournamentMatchesAsPlayerA TournamentMatch[]       @relation("tournamentMatchPlayerA")
  tournamentMatchesAsPlayerB TournamentMatch[]       @relation("tournamentMatchPlayerB")
  tournamentMatchesWon       TournamentMatch[]       @relation("tournamentMatchWinner")
  licences                 Licence[]

  @@index([rating, ratingGames])
  @@index([level, online])
  @@index([city])
  @@index([clubId])
}

// Clubs / structures de tennis — éditables par un admin (pas de redéploiement).
// Club = **unique entité « lieu »** de l'appli (fusion avec l'ancienne table Court,
// aoû. 2026). Sert à la fois d'appartenance des membres (`User.clubId`), d'annuaire
// (`/clubs`, `/clubs/:slug`) et de lieu de jeu : `court` reste stocké en texte sur
// Match/DispoPost/QuickMatch (historique stable), on rapproche par `name` pour la carte.
model Club {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  zone        String   @default("")
  location    String   @default("") // libellé court (affiché sur les cartes de l'annuaire)
  address     String? // adresse complète (fiche club)
  description String? // présentation du club (fiche club)
  feesInfo    String? // honoraires / cotisation, texte libre (fiche club)
  phone       String? // contact du club
  website     String? // site web du club
  imageUrl    String? // photo du club (Cloudinary, dossier atc/clubs) — null = placeholder
  lat         Float? // position (carte du lieu de jeu + fiche club)
  lng         Float?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  users User[]

  @@index([active, sortOrder])
}

// Les 5 niveaux : contenu affiché (nom, profil, jeu) éditable par un admin.
// Les bornes de rating ELO restent dans le code (src/modules/matches/elo.ts).
model Level {
  level     Int      @id // 1..5
  code      String // 'N1'..'N5'
  nom       String
  profil    String
  jeu       String
  updatedAt DateTime @default(now()) @updatedAt
}

model DispoPost {
  id        String         @id @default(cuid())
  userId    String
  when      DateTime
  duration  Int
  court     String
  type      String // 'simple' | 'double' | 'mixte'
  note      String?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id])
  requests  MatchRequest[]
  match     Match?

  @@index([userId])
  @@index([when, type])
}

model MatchRequest {
  id          String    @id @default(cuid())
  dispoPostId String
  requesterId String
  status      String // 'pending' | 'accepted' | 'declined'
  dispoPost   DispoPost @relation(fields: [dispoPostId], references: [id])

  @@index([dispoPostId, status])
  @@index([requesterId])
}

model QuickMatch {
  id           String   @id @default(cuid())
  challengerId String
  challengedId String
  when         DateTime
  court        String
  type         String // 'simple' | 'double' | 'mixte'
  note         String?
  status       String   @default("pending") // 'pending' | 'accepted' | 'declined'
  createdAt    DateTime @default(now())
  challenger   User     @relation("quickMatchChallenger", fields: [challengerId], references: [id])
  challenged   User     @relation("quickMatchChallenged", fields: [challengedId], references: [id])
  match        Match?

  @@index([challengerId, status])
  @@index([challengedId, status])
  @@index([when])
}

model Match {
  id                String      @id @default(cuid())
  hostId            String
  guestId           String
  playedAt          DateTime
  court             String
  type              String
  scoreHost         String
  scoreGuest        String
  winnerId          String
  status            String      @default("confirmed") // 'pending' | 'confirmed' | 'disputed'
  recordedBy        String? // userId who submitted the score
  // Contexte figé au moment où l'ELO s'applique (confirmation / résolution) —
  // sert au calcul des badges (outsider, tombeur…). Null = match d'avant la feature.
  hostRatingBefore  Int?
  guestRatingBefore Int?
  wasDisputed       Boolean     @default(false) // a transité par 'disputed' au moins une fois
  dispoPostId       String?     @unique
  quickMatchId      String?     @unique
  host              User        @relation("host", fields: [hostId], references: [id])
  guest             User        @relation("guest", fields: [guestId], references: [id])
  dispoPost         DispoPost?  @relation(fields: [dispoPostId], references: [id])
  quickMatch        QuickMatch? @relation(fields: [quickMatchId], references: [id])

  @@index([hostId, status, playedAt])
  @@index([guestId, status, playedAt])
  @@index([winnerId])
}

// Hauts faits débloqués (permanents) — cf. src/modules/badges/badges.engine.ts.
// Les « séries » (compteurs vivants : victoires d'affilée, matchs du mois, sans
// accroc) NE sont PAS stockées : elles sont recalculées à la lecture depuis
// l'historique. Ici on ne garde que ce qui doit être figé : la date de déblocage
// (affichage « débloqué le… ») et l'anti-double-notif.
model Achievement {
  id         String   @id @default(cuid())
  userId     String
  code       String // 'premier_match' | 'outsider' | 'le_tombeur' | … (badges.engine.ts)
  unlockedAt DateTime @default(now())
  context    Json? // détail figé au déblocage (ex. { from: 2, to: 3 } pour un passage de niveau)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // 'match_request' | 'match_confirmed' | 'match_declined' | 'quick_match_request' | 'score_recorded'
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ── Messagerie 1-to-1 entre joueurs ────────────────────────────────────────
// 1 conversation = 1 relation entre DEUX joueurs (et non 1 par match).
// La messagerie s'active à l'acceptation d'un premier match entre A et B ;
// toute acceptation ultérieure réutilise la même conversation.
// `pairKey` = les deux userId triés puis joints par ':' → clé métier unique.
// Le « rappel du match » est calculé à la lecture (dernier match accepté
// entre les deux joueurs), plus aucun lien direct vers DispoPost/QuickMatch.
model Conversation {
  id            String   @id @default(cuid())
  pairKey       String   @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now()) // tri de la liste des conversations

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now()) // base du calcul des non-lus

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String // borné 1..2000 par Zod
  createdAt      DateTime  @default(now())
  readAt         DateTime? // 1-to-1 : posé quand le destinataire ouvre la conversation

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Abonnement Web Push (VAPID) — un par appareil/navigateur.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Publications de la rubrique Actualité — éditées par un admin.
// Un seul modèle couvre tournois, événements, partenariats, infos tennis et news ATC.
// Visibilité calculée à la lecture (pas de tâche planifiée) :
//   status = 'published'  OU  (status = 'scheduled' ET publishedAt <= now())
model Post {
  id              String    @id @default(cuid())
  category        String // 'tournoi' | 'evenement' | 'partenariat' | 'infos_tennis' | 'atc'
  status          String    @default("draft") // 'draft' | 'scheduled' | 'published' | 'archived'
  title           String
  slug            String    @unique
  summary         String
  body            String // markdown
  coverImageUrl   String?
  gallery         String[]  @default([]) // URLs Cloudinary
  publishedAt     DateTime? // date de publication effective ou programmée
  startsAt        DateTime? // événements : début
  endsAt          DateTime? // événements : fin
  location        String?
  ctaLabel        String?
  ctaUrl          String? // https://… ou chemin interne (/matchs…)
  featured        Boolean   @default(false)
  featuredOrder   Int? // ordre dans le carrousel « à la une »
  promoCode       String? // partenariats
  source          String? // infos_tennis : nom de la source (RSS ou saisi)
  sourceUrl       String? // infos_tennis : lien vers l'article d'origine
  externalId      String?   @unique // guid RSS — dédupe des imports
  notifyOnPublish Boolean   @default(false)
  notifiedAt      DateTime? // anti double-envoi du push
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
  @@index([featured, featuredOrder])
  @@index([status, startsAt])
}

// Flux RSS agrégés dans la catégorie « Infos Tennis ». Gérés par un admin.
// Synchro : fetch-on-read (cache 6 h) + cron GitHub Actions.
model RssFeed {
  id          String    @id @default(cuid())
  url         String    @unique
  label       String
  autoPublish Boolean   @default(false) // sinon les articles arrivent en brouillon
  active      Boolean   @default(true)
  lastSyncAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
}

// Jetons de réinitialisation de mot de passe. On ne stocke que le SHA-256 du
// jeton (comme un mot de passe) ; usage unique ; expiration 30 min.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Classement fédéral — pivot produit (nov. 2026) : les matchs amicaux
// (`User.rating`) n'alimentent plus le classement officiel, seuls les
// résultats de tournoi comptent. Créé par un admin fédé, ouvert aux
// inscriptions, puis clos et résulté (points par joueur) à la fin.
model Tournament {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  location             String?
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  status               String    @default("upcoming") // 'upcoming' | 'open' | 'closed' | 'completed'
  // Règles d'éligibilité à l'inscription — contrôlées côté serveur, jamais
  // juste indicatives (ex. tournoi féminin, tournoi débutants).
  genderRule           String? // null (mixte) | 'homme' | 'femme'
  minLevel             Int? // null = pas de minimum (1..5)
  maxLevel             Int? // null = pas de maximum (1..5)
  maxPlayers           Int? // null = pas de plafond ; capacité du tableau
  allowedLicenceCategories String[] @default([]) // [] = pas de restriction ; sinon valeurs LicenceCategory (adulte, jeunes, ...)
  bracketPublished     Boolean   @default(false) // le tableau n'est visible des joueurs qu'une fois publié par l'admin
  createdAt            DateTime  @default(now())

  registrations TournamentRegistration[]
  results       TournamentResult[]
  matches       TournamentMatch[]

  @@index([status, startDate])
}

// Tableau à élimination directe généré par tirage au sort pour un tournoi.
// `round` 1 = premier tour (peut contenir des « byes » si l'effectif n'est
// pas une puissance de 2) ; le round le plus élevé est la finale. `slot`
// indexe la position dans le round (base 0) ; le vainqueur du match
// (round, slot) alimente automatiquement le match (round+1, floor(slot/2)).
model TournamentMatch {
  id           String    @id @default(cuid())
  tournamentId String
  round        Int
  slot         Int
  playerAId    String?
  playerBId    String?
  winnerId     String?
  scoreText    String?
  playedAt     DateTime?
  createdAt    DateTime  @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerA    User?      @relation("tournamentMatchPlayerA", fields: [playerAId], references: [id], onDelete: SetNull)
  playerB    User?      @relation("tournamentMatchPlayerB", fields: [playerBId], references: [id], onDelete: SetNull)
  winner     User?      @relation("tournamentMatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, slot])
  @@index([tournamentId])
}

model TournamentRegistration {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  registeredAt DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

// Points attribués par un admin fédé une fois le tournoi terminé — seule
// source du classement officiel (`GET /members/rankings`).
model TournamentResult {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  points       Int
  position     Int?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

// Licence-assurance FIT 2026 — grille officielle (doc fédération, nov. 2026) :
// 6 catégories, tarif + validité déterminés automatiquement par date de
// naissance + profil déclaré (jamais choisis librement par l'usager — voir
// resolveLicenceCategory). Paiement simulé pour le MVP de démonstration
// (aucun prestataire réel branché) ; pièce justificative/OCR/listes de
// contrôle club (coach, école) volontairement hors scope pour l'instant.
model Licence {
  id               String   @id @default(cuid())
  userId           String
  season           String
  category         String // 'adulte' | 'jeunes' | 'coach' | 'ecole' | 'decouverte_jeunes' | 'decouverte_adultes'
  disciplines      String[] // 'tennis' | 'padel'
  birthDate        DateTime
  birthPlace       String
  cniUrl           String // pièce justificative (CNI/passeport/extrait) — Cloudinary, non exposée publiquement
  photoUrl         String // photo d'identité
  licenceNumber    String   @unique // identifiant lisible, affiché sur le document (ex. FIT-2026-AB12CD)
  verificationCode String   @unique // jeton haute entropie encodé dans le QR — seul moyen d'authentifier le document
  amount           Int // FCFA — figé au moment du paiement (grille peut évoluer)
  paidAt           DateTime @default(now())
  expiresAt        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, season])
}
