# ── Serveur ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
# URL exacte du front (origine autorisée CORS + Socket.IO). En prod : https://<app>.vercel.app
CORS_ORIGIN=http://localhost:4200

# ── Base de données ───────────────────────────────────
# En local : les deux valeurs sont identiques.
# En prod (Neon) : DATABASE_URL = chaîne "pooled" (...-pooler...&pgbouncer=true),
#                  DIRECT_URL   = chaîne "direct" (sans -pooler), pour les migrations.
DATABASE_URL=postgresql://postgres:password@localhost:5432/atc
DIRECT_URL=postgresql://postgres:password@localhost:5432/atc

# ── Redis ─────────────────────────────────────────────
# Non utilisé actuellement (lib/redis.ts n'est importé nulle part). Laisser pour plus tard.
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────
# En prod : générer avec `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Connexion Google (facultatif) ─────────────────────
# ID client OAuth 2.0 (public), type « Application Web », créé dans la console
# Google Cloud. Doit être identique à `googleClientId` dans
# apps/web/src/environments/environment*.ts. Vide = bouton Google masqué.
GOOGLE_CLIENT_ID=

# ── Cloudinary (upload avatars) ───────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Maileroo (emails transactionnels) ─────────────────
MAILEROO_API_KEY=
MAIL_FROM_ADDRESS=noreply@atc.ci
MAIL_FROM_NAME=Abidjan Tennis Community
